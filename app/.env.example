# Origin of the Go service, without a trailing /api (e.g. https://open-skill-service-xyz.a.run.app).
# Leave empty to call /api on the same origin (Vite dev proxy or nginx in Docker).
VITE_API_URL=

# Firebase web app config (Project settings > Your apps). Public identifiers, not secrets.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Dev only: 1 = skip Firebase and send the trusted X-Demo-User header. Ignored in production builds.
VITE_DEMO_AUTH=
