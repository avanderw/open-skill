# Copy to service/.env (git-ignored) for local development. Never commit real tokens.
# Leave OPEN_SKILL_DB_URL empty to use the local SQLite file instead.
OPEN_SKILL_DB_URL=libsql://open-skill-avanderw.aws-eu-west-1.turso.io
OPEN_SKILL_DB_TOKEN=

# Firebase project whose ID tokens are accepted (public identifier).
OPEN_SKILL_FIREBASE_PROJECT_ID=open-skill-25b83
# Dev only: 1 = trust the X-Demo-User header. Never set in production.
OPEN_SKILL_DEMO_AUTH=
